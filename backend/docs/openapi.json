  "components": {
    "schemas": {
      "ActivityHistory": {
        "properties": {
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          },
          "employee_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Employee Id"
          },
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Event Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "in_progress",
              "dropped",
              "no_show",
              "declined",
              "overdue"
            ],
            "title": "Status"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
