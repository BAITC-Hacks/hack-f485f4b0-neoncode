            "title": "Score"
          },
          "feedback_rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback Rating"
          },
          "assigned_by": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "self",
                  "manager",
                  "hr"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned By"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "employee_id",
          "event_id",
          "date",
          "status"
